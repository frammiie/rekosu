{
  "name": "rekosu",
  "scripts": {
    "dev": "dotenvx run -f .env.dev -- vite dev",
    "build": "dotenvx run -f .env.staging -- vite build",
    "start": "dotenvx run -f .env.staging -- node .output/server/index.mjs",
    "lint": "eslint --fix \"**/*.{ts,tsx,js,jsx}\"",
    "infra:dev:up": "dotenvx run -f .env.dev -- docker compose -f docker-compose.dev.yml up --remove-orphans --build -d",
    "infra:dev:down": "dotenvx run -f .env.dev -- docker compose -f docker-compose.dev.yml down",
    "infra:staging:up": "dotenvx run -f .env.staging -- docker compose -f docker-compose.prod.yml up --build -d",
    "infra:staging:down": "dotenvx run -f .env.staging -- docker compose -f docker-compose.prod.yml down"
  },
  "type": "module",
  "devDependencies": {
    "@solid-primitives/intersection-observer": "^2.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@dotenvx/dotenvx": "^2.38.2",
    "@solid-primitives/page-visibility": "^2.1.6",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.1.0",
    "@types/chroma-js": "^3.1.3",
    "@types/umami-browser": "^2.18.1",
    "chroma-js": "^3.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "format-duration-time": "^1.5.4",
    "ioredis": "^6.0.0",
    "nitro": "3.0.260903-beta",
    "osu-api-v2-js": "^3.0.5",
    "osu-web.js": "^2.6.0",
    "pg": "^8.23.1",
    "postgres": "3.4.9",
    "solid-js": "^1.9.17",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
